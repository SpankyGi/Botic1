Options -MultiViews
RewriteEngine On

# Legacy hours URLs now belong to the single reservations-and-hours page.
RewriteRule ^ca/horaris/?$ /ca/reserves/ [R=301,L]
RewriteRule ^es/horarios/?$ /es/reservas/ [R=301,L]
RewriteRule ^en/hours/?$ /en/reservations/ [R=301,L]
RewriteRule ^fr/horaires/?$ /fr/reservations/ [R=301,L]

# Redirect bare root to /ca/
RewriteRule ^$ /ca/ [R=301,L]

# Les rutes vàlides es publiquen com HTML estàtic durant el build. Les URL
# inexistents reben un 404 real, en comptes de l'esquelet buit de la SPA.
ErrorDocument 404 /404.html
