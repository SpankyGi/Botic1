Options -MultiViews
RewriteEngine On

# Keep the established production host. Preview domains are unaffected.
RewriteCond %{HTTP_HOST} ^www\.bo-tic\.com$ [NC]
RewriteRule ^ https://bo-tic.com%{REQUEST_URI} [R=301,L]

# Existing public pages must keep their incoming links after migration.
RewriteRule ^restaurant/?$ /ca/restaurant/ [R=301,L]
RewriteRule ^menus/?$ /ca/menus/ [R=301,L]
RewriteRule ^horari/?$ /ca/reserves/ [R=301,L]

# Additional URLs discovered in the production sitemap and language navigation.
RewriteRule ^taula-del-xef/?$ /ca/taula-del-xef/ [R=301,L]
RewriteRule ^videos/?$ /ca/videos/ [R=301,L]
RewriteRule ^identitat/?$ /ca/identitat/ [R=301,L]
RewriteRule ^en/opening-hours/?$ /en/reservations/ [R=301,L]
RewriteRule ^(?:sitemap_index|page-sitemap|wp-sitemap)\.xml$ /sitemap.xml [R=301,L]

# Legacy hours URLs now belong to the single reservations-and-hours page.
RewriteRule ^ca/horaris/?$ /ca/reserves/ [R=301,L]
RewriteRule ^es/horarios/?$ /es/reservas/ [R=301,L]
RewriteRule ^en/hours/?$ /en/reservations/ [R=301,L]
RewriteRule ^fr/horaires/?$ /fr/reservations/ [R=301,L]

# Redirect bare root to /ca/
RewriteRule ^$ /ca/ [R=301,L]

<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
</IfModule>

# Les rutes vàlides es publiquen com HTML estàtic durant el build. Les URL
# inexistents reben un 404 real, en comptes de l'esquelet buit de la SPA.
ErrorDocument 404 /404.html
