Options -MultiViews
RewriteEngine On

# Only preview hosts are excluded from indexing; never propagate noindex to production.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{HTTP_HOST} =~ /(?i)\.hostingersite\.com$/"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' && %{HTTP_HOST} =~ /(?i)^(www\.)?bo-tic\.com$/"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^index-[A-Za-z0-9_-]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Redirect explicit directory indexes only when requested by the visitor.
RewriteCond %{THE_REQUEST} \s/+([^?\ ]*/)?index\.html(?:[?\ ]|$) [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# Keep the established production host. Preview domains are unaffected.
RewriteCond %{HTTP_HOST} ^www\.bo-tic\.com$ [NC]
RewriteRule ^ https://bo-tic.com%{REQUEST_URI} [R=301,L]

# Existing public pages must keep their incoming links after migration.
RewriteRule ^wp-content/uploads/sb-instagram-feed-images/568675773_18505317565071061_2232430570051798181_nfull\.webp$ /images/legacy/botic-instagram-18505317565071061.webp [R=301,L]
RewriteRule ^restaurant/?$ /ca/restaurant/ [R=301,L]
RewriteRule ^menus/?$ /ca/menus/ [R=301,L]
RewriteRule ^horari/?$ /ca/reserves/ [R=301,L]

# Additional URLs discovered in the production sitemap and language navigation.
RewriteRule ^taula-del-xef/?$ /ca/taula-del-xef/ [R=301,L]
RewriteRule ^videos/?$ /ca/videos/ [R=301,L]
RewriteRule ^identitat/?$ /ca/identitat/ [R=301,L]
RewriteRule ^en/opening-hours/?$ /en/reservations/ [R=301,L]
RewriteRule ^(?:sitemap_index|page-sitemap|wp-sitemap)\.xml$ /sitemap.xml [R=301,L]

# Legacy hours URLs now belong to the single reservations-and-hours page.
RewriteRule ^ca/horaris/?$ /ca/reserves/ [R=301,L]
RewriteRule ^es/horarios/?$ /es/reservas/ [R=301,L]
RewriteRule ^en/hours/?$ /en/reservations/ [R=301,L]
RewriteRule ^fr/horaires/?$ /fr/reservations/ [R=301,L]

# Redirect bare root to /ca/
RewriteRule ^$ /ca/ [R=301,L]

<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
</IfModule>

# Les rutes vàlides es publiquen com HTML estàtic durant el build. Les URL
# inexistents reben un 404 real, en comptes de l'esquelet buit de la SPA.
ErrorDocument 404 /404.html

# Preserve legacy image URLs using the same photographs, converted to WebP.
RewriteRule ^wp\-content/uploads/2024/11/Botic\-10\-scaled\.webp$ /images/legacy/botic-botic-10-scaled.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/11/Botic\-retrats\-6\.jpg$ /images/legacy/botic-botic-retrats-6.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/11/Botic\-sala\-3\-scaled\.webp$ /images/legacy/botic-botic-sala-3-scaled.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/11/Foto_plat_1\-1\.webp$ /images/legacy/botic-foto-plat-1-1.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/11/Logo_GuiaRepsol\.png$ /images/legacy/botic-logo-guiarepsol.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/11/Logo_Michelin\-1\.png$ /images/legacy/botic-logo-michelin-1.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/11/Logo_PremiNacional\.png$ /images/legacy/botic-logo-preminacional.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/11/Logo_PremisGirona\.png$ /images/legacy/botic-logo-premisgirona.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/11/Taula\-del\-xef\.jpg$ /images/legacy/botic-taula-del-xef.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/11/plat\-2\.jpg$ /images/legacy/botic-plat-2.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/11/plat\-3\.jpg$ /images/legacy/botic-plat-3.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/12/Botic\-sala\-2\-1\.jpg$ /images/legacy/botic-botic-sala-2-1.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/12/Botic\-sala\-7\-1\.jpg$ /images/legacy/botic-botic-sala-7-1.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/12/PetitMenu@4x\.png$ /images/legacy/botic-petitmenu-4x.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/12/albert\-sastregener\.jpg$ /images/legacy/botic-albert-sastregener.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/12/logo_Bo\.TiC_3\.png$ /images/legacy/botic-logo-bo-tic-3.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/12/logo_Bo\.TiC_9\.png$ /images/legacy/botic-logo-bo-tic-9.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2024/12/sala\-botic\.jpg$ /images/legacy/botic-sala-botic.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2025/03/cercle\-professionals\-de\-sala\.png$ /images/legacy/botic-cercle-professionals-de-sala.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2025/05/un\-espai\-unic\-bo\.tic_\.png$ /images/legacy/botic-un-espai-unic-bo-tic.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2025/08/DSC2153_tallada\-scaled\.jpg$ /images/legacy/botic-dsc2153-tallada-scaled.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2025/08/DSC3390\-scaled\.jpg$ /images/legacy/botic-dsc3390-scaled.webp [R=301,L]
RewriteRule ^wp\-content/uploads/2025/12/Cristina\-i\-Albert\-scaled\.jpg$ /images/legacy/botic-cristina-i-albert-scaled.webp [R=301,L]

# Legacy WooCommerce retired; gift vouchers are managed in Restoo.
RewriteRule ^botiga/?$ https://bo-tic.myrestoo.net/ca/tienda [R=301,L,QSD]
RewriteRule ^cistella/?$ - [G,L]
RewriteRule ^el\-meu\-compte/?$ - [G,L]
RewriteRule ^finalitza\-la\-compra/?$ - [G,L]
RewriteRule ^reemborsaments_devolucions/?$ - [G,L]
RewriteRule ^el\-meu\-compte/lost\-password/?$ - [G,L]
RewriteRule ^en/cart/?$ - [G,L]
RewriteRule ^en/my\-account/?$ - [G,L]
RewriteRule ^en/shop/?$ https://bo-tic.myrestoo.net/en/tienda [R=301,L,QSD]
RewriteRule ^es/carrito/?$ - [G,L]
RewriteRule ^es/mi\-cuenta/?$ - [G,L]
RewriteRule ^es/tienda/?$ https://bo-tic.myrestoo.net/es/tienda [R=301,L,QSD]
RewriteRule ^fr/boutique/?$ https://bo-tic.myrestoo.net/fr/tienda [R=301,L,QSD]
RewriteRule ^fr/mon\-compte/?$ - [G,L]
RewriteRule ^fr/panier/?$ - [G,L]
RewriteRule ^en/my\-account/lost\-password/?$ - [G,L]
RewriteRule ^es/mi\-cuenta/lost\-password/?$ - [G,L]
RewriteRule ^fr/mon\-compte/lost\-password/?$ - [G,L]
ErrorDocument 410 /404.html
