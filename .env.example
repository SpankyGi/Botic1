# Aquest fitxer ja no s'utilitza per configurar l'endpoint dels menús.
# L'URL de Google Apps Script es configura a:
#
#   public/config.json  (per a dev local i deploy a Hostinger)
#
# Vegeu docs/MENUS-CMS.md per a les instruccions completes.

# Analítica opcional: no s'injecta cap servei fins que l'usuari n'accepta la categoria.
# VITE_GA4_ID=G-XXXXXXXXXX

# Exemple per desenvolupament. Producció es configura a .env.production.
VITE_ANALYTICS_ENABLED=false
# VITE_GTM_ID=GTM-XXXXXXX
# Amb GTM configurat, GA4 es configura DINS de GTM; no es carrega un segon gtag.
# VITE_ANALYTICS_DEBUG=true # Només proves locals explícites; no publicar.
# Clarity i Meta Pixel es gestionen dins de GTM, amb els permisos de consentiment.
